#! ia 1.0

@workspace ia-product-base-kit
  meaning
    says "The seat workspace that composes the IA product base kit's system with the public systems it builds on."
    answers "Which systems does the IA product base kit workspace compose?"
  composition
    systems [@system agent-system, @system compliance-system, @system governance-system, @system work-system, @system workspace-system, @system product-base-system]
    sources [".ia/src @authored"]
    steward @agent ia-product-base-kit

@agent ia-product-base-kit
  meaning
    says "The IDE agent operating in the IA product base kit workspace, any vendor."
    answers "Which participant acts in the IA product base kit workspace?"
  governance
    applies []

@mandate ia-product-base-kit-mandate
  meaning
    says "The bounded authority of the participant in the IA product base kit workspace."
    answers "Which moves may the participant make in the IA product base kit workspace?"
  governance
    requires "Claim no host permission or execution from this mandate."
  authority
    participant @agent ia-product-base-kit
    moves [Observation, Verification, Synthesis, Delegation, Execution]
    scope [@workspace ia-product-base-kit]
