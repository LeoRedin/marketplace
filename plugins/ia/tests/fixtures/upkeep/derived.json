{
  "format": 1,
  "outputs": [
    {
      "id": "architecture-map",
      "inputs": [".ia/src/**/*.ia"],
      "generator": { "script": "scripts/mermaid-map.mjs" },
      "output": "docs/architecture.mmd"
    },
    {
      "id": "spec-plain-voice",
      "inputs": ["docs/spec.md"],
