#! ia 1.0

@workspace ia-authoring-kit
  meaning
    says "The workspace that composes the IA authoring kit's four systems with the public systems they build on."
    answers "Which systems does the IA authoring kit compose?"
  composition
    systems [@system agent-composition-system, @system agent-system, @system authoring-system, @system compliance-system, @system governance-system, @system hook-authoring-system, @system learning-system, @system session-system, @system template-system, @system work-system, @system workspace-system, @system ia-authoring, @system ia-authoring-record, @system ia-authoring-host, @system ia-authoring-catalogue]
    sources [".ia/src @authored"]
    steward @agent ia-authoring-kit

@agent ia-authoring-kit
  meaning
    says "The IDE agent operating in the IA authoring kit's workspace, any vendor."
    answers "Which participant acts in the IA authoring kit's workspace?"
  governance
    applies []

@mandate ia-authoring-kit-mandate
  meaning
    says "The bounded authority of the participant in the IA authoring kit's workspace."
    answers "Which moves may the participant make in the IA authoring kit's workspace?"
  governance
    requires "Claim no host permission or execution from this mandate."
  authority
    participant @agent ia-authoring-kit
    moves [Observation, Verification, Synthesis, Delegation, Execution]
    scope [@workspace ia-authoring-kit]
