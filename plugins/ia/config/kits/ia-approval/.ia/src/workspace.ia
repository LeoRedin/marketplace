#! ia 1.0

@workspace ia-approval-kit
  meaning
    says "The seat workspace that composes the IA approval base kit's system with the public systems it builds on."
    answers "Which systems does the IA approval kit workspace compose?"
  composition
    systems [@system agent-system, @system compliance-system, @system governance-system, @system work-system, @system workspace-system, @system approval-system]
    sources [".ia/src @authored"]
    steward @agent ia-approval-kit

@agent ia-approval-kit
  meaning
    says "The IDE agent operating in the IA approval kit workspace, any vendor."
    answers "Which participant acts in the IA approval kit workspace?"
  governance
    applies []

@mandate ia-approval-kit-mandate
  meaning
    says "The bounded authority of the participant in the IA approval kit workspace."
    answers "Which moves may the participant make in the IA approval kit workspace?"
  governance
    requires "Claim no host permission or execution from this mandate."
  authority
    participant @agent ia-approval-kit
    moves [Observation, Verification, Synthesis, Delegation, Execution]
    scope [@workspace ia-approval-kit]
