{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Private team catalog subset (Claude)",
  "required": [
    "name",
    "owner",
    "plugins"
  ],
  "properties": {
    "name": {
      "const": "inventarch"
    },
    "owner": {
      "const": {
        "name": "InventArch"
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
